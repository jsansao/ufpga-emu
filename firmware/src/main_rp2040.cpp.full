static const char *pinmap_json =
    "["
    "  {\"name\":\"clk\",\"pin\":2,\"bit\":0,\"dir\":\"input\"},"
    "  {\"name\":\"d\",\"pin\":4,\"bit\":1,\"dir\":\"input\"},"
